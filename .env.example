# ================================================================
# Fall Risk Platform — Environment Configuration Template (.env)
# COPY this file to: .env  (และแก้ไข credentials ตามบริบท รพ.)
# ================================================================

# Application Environment & Network Ports
APP_ENV=production
FRONTEND_PORT=3030
BACKEND_PORT=8000
DB_PORT=5432

# Hospital Identity
HOSPITAL_CODE=10986
HOSPITAL_NAME=โรงพยาบาลสมเด็จพระยุพราชสายบุรี
HIS_TYPE=HOSXP

# Platform Database (PostgreSQL)
POSTGRES_DB=fall_risk_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/fall_risk_db

# HOSxP MySQL Connection (Read-Replica)
HOSXP_HOST=192.168.0.250
HOSXP_PORT=3306
HOSXP_USER=sa
HOSXP_PASSWORD=sa
HOSXP_DB=hos

# Clinical ML & Retraining Settings
DEFAULT_THRESHOLD=0.47
AUTO_RETRAIN_THRESHOLD=50
MODELS_DIR=models_storage

# Background Screening Daemon
DAEMON_POLL_INTERVAL=30
DAEMON_MIN_AGE=60

# Cybersecurity & JWT Authentication
# สร้างรหัสปลอดภัย: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=saiburi-hospital-fallrisk-super-secret-key-2026-secure-jwt
JWT_EXPIRATION_HOURS=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
