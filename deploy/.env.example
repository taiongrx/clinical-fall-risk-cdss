# ==============================================================================
# Clinical Fall Risk CDSS - Hospital Production Environment Template
# ==============================================================================

# 1. Hospital Identification (รหัสสถานพยาบาล 5 หลัก และชื่อ รพ.)
HOSPITAL_CODE=10986
HOSPITAL_NAME="โรงพยาบาลตัวอย่าง"

# 2. Hospital Information System (HIS) Integration
# Supported HIS_TYPE: HOSXP, HOMC, JHCIS, FHIR
HIS_TYPE=HOSXP
HOSXP_HOST=192.168.0.250
HOSXP_PORT=3306
HOSXP_USER=reader_user
HOSXP_PASSWORD=your_secure_password
HOSXP_DB=hos

# 3. Clinical Decision Support & Model Calibration
DEFAULT_THRESHOLD=0.47
DAEMON_POLL_INTERVAL=30
DAEMON_MIN_AGE=60
AUTO_RETRAIN_THRESHOLD=50

# 4. Internal Database (PostgreSQL 16)
POSTGRES_DB=fall_risk_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisSecurePasswordInProduction123!
DATABASE_URL=postgresql://postgres:ChangeThisSecurePasswordInProduction123!@db:5432/fall_risk_db

# 5. Security & Authentication
JWT_SECRET_KEY=generate-a-random-64-character-secret-key-for-production
JWT_EXPIRATION_HOURS=8
APP_ENV=production
