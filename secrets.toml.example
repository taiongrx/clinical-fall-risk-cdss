# ================================================================
# secrets.toml.example — Configuration Template
# COPY to: secrets.toml  (ห้าม commit ไฟล์จริงเข้า git)
# ================================================================

[hosxp]
host     = "192.168.X.XXX"
port     = 3306
user     = "sa"
password = "YOUR_HOSXP_PASSWORD"
database = "hos"

[database]
url = "postgresql://postgres:YOUR_POSTGRES_PASSWORD@db:5432/fall_risk_db"

[ml]
default_threshold      = 0.47
auto_retrain_threshold = 50

[hospital]
hospital_code = "10986"
hospital_name = "โรงพยาบาลสมเด็จพระยุพราชสายบุรี"
his_type      = "HOSXP"

[auth]
# สร้าง random key: python -c "import secrets; print(secrets.token_hex(32))"
jwt_secret_key       = "CHANGE_TO_64_CHAR_RANDOM_HEX_STRING"
jwt_expiration_hours = 8
max_login_attempts   = 5
lockout_minutes      = 15
